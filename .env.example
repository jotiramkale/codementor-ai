# Frontend API origin. FastAPI local development listens on port 8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Docker Compose values. Replace both before running `docker compose up`.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters
