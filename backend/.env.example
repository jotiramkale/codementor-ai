# CodeMentor AI backend environment variables.
# Copy to .env and fill in real values; never commit the real .env file.

# --- Runtime ---
ENVIRONMENT=development

# --- Database (Phase 20+) ---
DATABASE_URL=postgresql+psycopg2://codementor:change-me@localhost:5432/codementor

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-unique-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI (Phase 22) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_COMPLETION_TOKENS=1600
GROQ_REASONING_EFFORT=low

# --- RAG (Phase 23) ---
CHROMA_PERSIST_DIR=./chroma_data
RAG_COLLECTION_NAME=codementor_knowledge
RAG_MEMORY_COLLECTION_NAME=codementor_user_memory
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_CHARS=1200
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.15
RAG_MAX_CONTEXT_CHARS=12000

# --- Docker code execution (Phase 21) ---
# Build the four images using the commands in README.md before starting
# the API. Requests never pull images automatically.
EXECUTION_DOCKER_COMMAND=docker
EXECUTION_ENABLED=true
EXECUTION_PYTHON_IMAGE=codementor-python:phase21
EXECUTION_JAVASCRIPT_IMAGE=codementor-javascript:phase21
EXECUTION_JAVA_IMAGE=codementor-java:phase21
EXECUTION_CPP_IMAGE=codementor-cpp:phase21
EXECUTION_TIMEOUT_SECONDS=3
EXECUTION_COMPILE_TIMEOUT_SECONDS=20
EXECUTION_JOB_TIMEOUT_SECONDS=180
EXECUTION_MEMORY_MB=256
EXECUTION_CPU_LIMIT=0.5
EXECUTION_PIDS_LIMIT=32
EXECUTION_OUTPUT_LIMIT_BYTES=32768
EXECUTION_MAX_SOURCE_BYTES=262144
EXECUTION_MAX_TEST_CASE_BYTES=32768
EXECUTION_MAX_INPUT_BYTES=1048576
EXECUTION_MAX_TESTS=50
EXECUTION_MAX_CONCURRENT_JOBS=2

# --- CORS ---
# Comma-separated allowed browser origins for local Vite and Compose web.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
