# CodeMentor AI backend environment variables.
# Copy to .env and fill in real values — never commit the real .env file.

# --- Database (Phase 20+) ---
DATABASE_URL=postgresql+psycopg2://codementor:changeme@localhost:5432/codementor

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI (Phase 22) ---
GROQ_API_KEY=your_groq_api_key_here

# --- RAG (Phase 23) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- CORS ---
# The Vite dev server's default origin — add your deployed frontend's
# real origin here too once one exists.
FRONTEND_ORIGIN=http://localhost:5173
